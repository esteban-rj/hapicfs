# Optional for local process. Never commit the populated .env file.
# The launcher loads this file on the server only.
OPENAI_API_KEY=
HERMES_IMAGE=nousresearch/hermes-agent:stable
# Model used by the persistent image-generation tool (separate from chat model).
HAPIC_IMAGE_MODEL=gpt-image-2.5-flare
# For Compose, use the absolute host path; scripts/start-docker.ps1 sets it.
# HAPIC_HOST_DATA_DIR=C:/Users/your-user/Documents/Github/hapic/.hapic
# YouTube OAuth is configured by the operator. Set paths, never inline JSON or client secrets.
# Native server: HAPIC_YOUTUBE_CLIENT_FILE=/absolute/private/path/google-oauth.json
# Docker Compose override: HAPIC_YOUTUBE_CLIENT_JSON=/absolute/private/path/google-oauth.json
